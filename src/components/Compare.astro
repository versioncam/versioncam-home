---
// Compared with what people use instead: for someone choosing a way to show
// a product in a video, not the README's table of developer tools. Every
// cell of the other columns comes from that tool's own pages, read on the
// day in `READ`, and the last row links them. A cell is a mark and a few
// words: a tick, a cross, or a dash where the tool's pages don't say, which
// the paragraph above the table explains. No adjective about anyone, ours
// included, and the two rows a clip loses (clicking through, a voice) stay in.
//
// The marks are drawn like every icon on the site, on the 16-unit grid in a
// square-ended stroke, in the cell's own colour: no green and no red, since
// red means recording here. Each carries its word for a screen reader.
//
// A row is a question and a column a way of doing it, so on a phone each
// row folds into a block with every answer labelled by its column, rather
// than a table wider than the screen.

const READ = '2026-11-11';

type Mark = 'yes' | 'no' | 'unknown';
const MARKS: Record<Mark, { path: string; word: string }> = {
	yes: { path: 'M3 8.5l3.5 3.5L13 4.5', word: 'Yes' },
	no: { path: 'M4 4l8 8M12 4l-8 8', word: 'No' },
	unknown: { path: 'M4 8h8', word: 'Not stated' },
};

const columns = [
	{ name: 'A screen recording', examples: 'Loom, Screen Studio' },
	{ name: 'A click-through demo', examples: 'Arcade, Supademo' },
	{ name: "Playwright's video", examples: 'a test artifact' },
	{ name: 'versioncam', examples: 'a clip' },
];

const rows: { question: string; answers: [Mark, string][] }[] = [
	{
		question: 'Made again when the app changes',
		answers: [
			['no', 'By hand'],
			['no', 'By hand, or edited'],
			['yes', 'On every test run'],
			['yes', 'On every push'],
		],
	},
	{
		question: 'Tells you when the flow breaks',
		answers: [
			['unknown', ''],
			['unknown', ''],
			['yes', 'The test fails'],
			['yes', 'Names the control'],
		],
	},
	{
		question: 'Names the version of the product',
		answers: [
			['unknown', ''],
			['unknown', 'Supademo versions the demo'],
			['unknown', ''],
			['yes', 'Branch and commit'],
		],
	},
	{
		question: 'A viewer can click through it',
		answers: [
			['no', 'A video'],
			['yes', 'Step by step'],
			['no', 'A video'],
			['no', 'A video'],
		],
	},
	{
		question: 'A voice',
		answers: [
			['yes', 'Recorded, or from a script'],
			['yes', 'Generated or recorded'],
			['unknown', ''],
			['no', 'Silent'],
		],
	},
];

const sources = [
	[
		{ text: 'Loom', href: 'https://www.loom.com/pricing' },
		{ text: 'Loom help', href: 'https://support.atlassian.com/loom/' },
		{ text: 'Screen Studio', href: 'https://screen.studio/' },
	],
	[
		{ text: 'Arcade', href: 'https://www.arcade.software/product/interactive-demo' },
		{ text: 'Supademo', href: 'https://supademo.com/features/guided-demos' },
		{ text: 'Supademo docs', href: 'https://docs.supademo.com/' },
	],
	[{ text: 'Playwright: Videos', href: 'https://playwright.dev/docs/videos' }],
	[{ text: 'The docs', href: '/more/version-cam/' }],
];
---

<div class="vc-compare not-content">
	<table>
		<thead>
			<tr>
				<td></td>
				{
					columns.map((c) => (
						<th scope="col">
							{c.name}
							<span class="vc-compare-examples">{c.examples}</span>
						</th>
					))
				}
			</tr>
		</thead>
		<tbody>
			{
				rows.map((row) => (
					<tr>
						<th scope="row">{row.question}</th>
						{row.answers.map(([mark, note], i) => (
							<td data-column={columns[i].name} class={`is-${mark}`}>
								<span class="vc-mark">
									<svg viewBox="0 0 16 16" aria-hidden="true">
										<path d={MARKS[mark].path} />
									</svg>
									<span class="sr-only">{MARKS[mark].word}{note ? ':' : ''}</span>
								</span>
								{note && <span class="vc-mark-note">{note}</span>}
							</td>
						))}
					</tr>
				))
			}
			<tr class="vc-compare-sources">
				<th scope="row">Read on {READ} from</th>
				{
					sources.map((links, i) => (
						<td data-column={columns[i].name}>
							{links.map((link, j) => (
								<>
									{j > 0 && ', '}
									<a href={link.href}>{link.text}</a>
								</>
							))}
						</td>
					))
				}
			</tr>
		</tbody>
	</table>
</div>
