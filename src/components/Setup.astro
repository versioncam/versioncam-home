---
// The whole setup, where a developer can copy it, two ways. A setup prompt
// for a coding agent, which is the way most people will take; and the shell
// commands as the README gives them, with the one sentence to say to Claude
// Code after, for whoever types. The commands and the prompt come from the
// package's README through the importer (src/lib/setup.ts builds the prompt
// for a README older than 0.7.7), so the page never shows a command the
// published version does not have, and the two never disagree.
//
// The head says which agent the prompt is tested with, and no more: it named
// Codex and "any agent" until 2026-11-09, when nobody had run either.
import { escape } from '../lib/take';
import { promptFor } from '../lib/setup';

const { data } = Astro.locals.starlightRoute.entry;
const install: string[] = data.install ?? [];
const ask: string | null | undefined = data.ask;

// Built as strings: inside <pre>, a template's own indentation would print.
const prompt = (sign: string) => `<span class="vc-prompt" aria-hidden="true">${sign} </span>`;
const terminal = install.map((line) => prompt('$') + escape(line)).join('\n');
const request = ask ? prompt('&gt;') + escape(ask) : '';
const setup = promptFor(data);
// Shown on request, so a reader can check what they are about to paste.
const preview = escape(setup);
---

<div class="vc-install vc-setup not-content">
	<section class="vc-install-block vc-setup-prompt">
		<div class="vc-install-head">
			<span>Setup prompt</span>
			<span class="vc-marks">
				<span>
					<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3.5 3.5L13 4.5" /></svg>
					Tested with Claude Code
				</span>
			</span>
		</div>
		<div class="vc-setup-prompt-body">
			<h3>Use a setup prompt</h3>
			<p>Copy it into a coding agent on your computer and send it as it is.</p>
			<button type="button" class="vc-copy-prompt" data-copy={setup} data-done-label="Copied">
				<span class="vc-copy-label">Copy prompt</span>
			</button>
			<details class="vc-setup-preview">
				<summary>Show the prompt</summary>
				<pre><code set:html={preview} /></pre>
			</details>
		</div>
	</section>
	<div class="vc-setup-type">
		<div class="vc-install-block">
			<div class="vc-install-head">
				<span>By hand, in a terminal</span>
				<button
					type="button"
					class="vc-copy"
					data-copy={install.join('\n')}
					aria-label="Copy the three commands"
				>
					<svg class="vc-icon-copy" viewBox="0 0 16 16" aria-hidden="true">
						<path d="M5.5 5.5h8v8h-8zM10.5 5.5v-3h-8v8h3" />
					</svg>
					<svg class="vc-icon-done" viewBox="0 0 16 16" aria-hidden="true">
						<path d="M3 8.5l3.5 3.5L13 4.5" />
					</svg>
				</button>
			</div>
			<pre><code set:html={terminal} /></pre>
		</div>
		{
			ask && (
				<div class="vc-install-block">
					<div class="vc-install-head">
						<span>Then, in Claude Code</span>
						<button type="button" class="vc-copy" data-copy={ask} aria-label="Copy the request">
							<svg class="vc-icon-copy" viewBox="0 0 16 16" aria-hidden="true">
								<path d="M5.5 5.5h8v8h-8zM10.5 5.5v-3h-8v8h3" />
							</svg>
							<svg class="vc-icon-done" viewBox="0 0 16 16" aria-hidden="true">
								<path d="M3 8.5l3.5 3.5L13 4.5" />
							</svg>
						</button>
					</div>
					<pre><code set:html={request} /></pre>
				</div>
			)
		}
	</div>
	<p class="vc-copied" role="status" aria-live="polite" />
</div>

<script>
	import { wireCopyButtons } from '../lib/copy';
	wireCopyButtons();
</script>
