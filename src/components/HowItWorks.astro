---
// The four steps of setting up, the same for every repository, at the head
// of Set up, the page's last section, above the prompt and the commands they
// describe. Each step is a label and one sentence, so the rail reads at a
// glance; what differs between a public and a private repository is in the
// docs, which the hosted section links.
//
// The steps are told as they go with a coding agent, which is how nearly
// every clip gets written. Step four says that CI needs no agent, so nobody
// reads the first three as "a model makes the video".
//
// One icon per step, drawn on the site's 16-unit grid in the same
// square-ended 1.5 stroke as the copy and play icons, to say what the step
// does rather than to decorate it. The step's number is `dim`: amber is for a
// number read from an artifact, and an ordinal is not one.

const ICONS = {
	// A terminal: the frame and a prompt, where the setup prompt is pasted.
	install: 'M1.5 2.5h13v11h-13zM4.5 6l2 2-2 2M8.5 10.5h3',
	// A page being written: the script.
	write: 'M3.5 1.5h6l3 3v10h-9zM9.5 1.5v3h3M5.5 8.5h5M5.5 11h3',
	// Up and out of the repository: the push that publishes.
	publish: 'M8 11V2.5M4.5 6L8 2.5 11.5 6M2.5 10v3.5h11V10',
	// Again and again: every push.
	every: 'M13 8a5 5 0 1 1-1.46-3.54M13.5 1.5v3h-3',
};

const steps = [
	{
		icon: ICONS.install,
		label: 'Paste the setup prompt',
		text: 'Your agent installs versioncam and asks what the first clip should show.',
	},
	{
		icon: ICONS.write,
		label: 'The agent writes the clip',
		text: 'It records the clip, and a separate reviewer checks the frames.',
	},
	{
		icon: ICONS.publish,
		label: 'Put it on version.cam',
		text: '<code>npx versioncam ci</code> writes the GitHub workflow. You commit it and push.',
	},
	{
		icon: ICONS.every,
		label: 'Every push',
		text: 'CI records every clip again, with no agent. A clip that no longer matches fails the build.',
	},
];
---

<div class="vc-how not-content">
	<ol class="vc-how-steps">
		{
			steps.map((step, i) => (
				<li>
					<div class="vc-how-rail" aria-hidden="true">
						<svg viewBox="0 0 16 16">
							<path d={step.icon} />
						</svg>
					</div>
					<div class="vc-how-body">
						<p class="vc-how-label">
							<span class="vc-how-num">{String(i + 1).padStart(2, '0')}</span>
							{step.label}
						</p>
						<p class="vc-how-text" set:html={step.text} />
					</div>
				</li>
			))
		}
	</ol>
</div>
