---
// Where a clip plays: on the left, a clip of the recorder's own repository
// embedded with the iframe its page on version.cam gives, character for
// character, so a reader sees what a customer's docs page shows, the line
// in the video's corner that names the commit included. On the right, the
// platforms as the package README's table found them, each with what to
// paste in a few words, and one line for when they were tested; every
// snippet and what each platform does with it are in the docs.
//
// The clip is the example's third, so the page doesn't play the hero's
// footage again. The list says only what a test on a real page showed;
// Zendesk's row says it was the editor, because that test had no public
// help center to read.

const CLIP = 'https://clips.version.cam/versioncam/versioncam/03-cancel-a-shipment';

const platforms = [
	{ name: 'Notion', paste: 'The link, then Create embed' },
	{ name: 'Confluence Cloud', paste: '<code>/embed</code>, then the link' },
	{ name: 'GitBook', paste: '<a href="https://app.gitbook.com/integrations/versioncam">Our integration</a>, then the link' },
	{ name: 'Mintlify, MkDocs, Starlight', paste: 'The iframe' },
	{ name: 'Docusaurus', paste: 'The iframe, as JSX' },
	{ name: 'A GitHub README', paste: 'The GIF, in Markdown' },
	{ name: 'Zendesk Guide', paste: 'The iframe, in the article editor' },
];
---

<div class="vc-plays not-content">
	<section class="vc-plays-col">
		<h3>The iframe, pasted</h3>
		<iframe
			src={`${CLIP}/embed`}
			style="width:100%;aspect-ratio:1280/800;border:0"
			allow="fullscreen"
			loading="lazy"
			title="Cancel a shipment"></iframe>
		<p class="vc-plays-note">
			The line in the corner names the branch, the commit and when the clip last passed its check. It
			links to <a href={CLIP}>the clip's page</a>.
		</p>
	</section>

	<section class="vc-plays-col">
		<h3>What to paste</h3>
		<dl class="vc-plays-list">
			{
				platforms.map((p) => (
					<div>
						<dt>{p.name}</dt>
						<dd set:html={p.paste} />
					</div>
				))
			}
		</dl>
		<p class="vc-plays-note">
			Tested on real pages on 10 and 11 November 2026. <a href="/more/version-cam/#embed-a-clip">Embed a
			clip</a> in the docs has every snippet.
		</p>
	</section>
</div>
