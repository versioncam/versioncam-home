---
// The front page's first screen: what versioncam is, in two sentences, and
// beside them the instrument that shows it (ChangeTheApp.astro): change the
// example app three ways and watch what CI does with its demo. A page without
// `clips` in its frontmatter (the 404, How a clip works) keeps Starlight's
// hero.
//
// The title, one line under it with the one button beside it, and the
// instrument across the page under them: a reader plays it rather than
// reads it. The docs and the source are in the links at the foot of the page
// and the header; the beta note shows only on a phone, where the header's
// badge and Sign in are hidden.
//
// The button copies the setup prompt, because a coding agent is how a clip
// gets written and the prompt is the whole way in: one paste installs the
// package and records a first clip. The four words under it say where the
// prompt goes, since a button that copies something unnamed gets pasted
// nowhere.
import Default from '@astrojs/starlight/components/Hero.astro';
import ChangeTheApp from './ChangeTheApp.astro';
import { promptFor } from '../lib/setup';

const { data } = Astro.locals.starlightRoute.entry;
const clips = data.clips;
const note = data.note;
const { title = data.title, tagline } = data.hero ?? {};
const setup = promptFor(data);
---

{
	clips ? (
		<div class="vc-hero is-change">
			<div class="vc-hero-copy">
				<h1 id="_top" data-page-title set:html={title} />
				<div class="vc-hero-row">
					{tagline && <p class="vc-hero-tagline" set:html={tagline} />}
					<div class="vc-hero-act">
						<button type="button" class="vc-copy-prompt" data-copy={setup} data-done-label="Copied">
							<span class="vc-copy-label">Copy setup prompt</span>
						</button>
						<p class="vc-hero-how">Then paste it into Claude Code.</p>
						<p class="vc-copied" role="status" aria-live="polite" />
						{note && <p class="vc-hero-note" set:html={note} />}
					</div>
				</div>
			</div>
			<ChangeTheApp />
		</div>
	) : (
		<Default />
	)
}

<script>
	import { wireCopyButtons } from '../lib/copy';
	wireCopyButtons();
</script>
