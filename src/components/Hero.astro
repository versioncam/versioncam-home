---
// The front page's first screen: what versioncam is, in three sentences, and
// the film CI made, playing beside them. A page without `clips` in its
// frontmatter (the 404) keeps Starlight's hero.
import Default from '@astrojs/starlight/components/Hero.astro';
import { LinkButton } from '@astrojs/starlight/components';
import Film from './Film.astro';

const { data } = Astro.locals.starlightRoute.entry;
const clips = data.clips;
const note = data.note;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
---

{
	clips ? (
		<div class="vc-hero">
			<div class="vc-hero-copy">
				<h1 id="_top" data-page-title set:html={title} />
				{tagline && <p class="vc-hero-tagline" set:html={tagline} />}
				<div class="vc-hero-actions">
					{actions.map(({ link, text, variant, icon }) => (
						<LinkButton href={link} variant={variant} icon={icon?.name}>
							{text}
						</LinkButton>
					))}
				</div>
				{note && <p class="vc-hero-note" set:html={note} />}
			</div>
			<Film base={clips} />
		</div>
	) : (
		<Default />
	)
}
