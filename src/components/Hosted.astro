---
// After CI: what version.cam adds to a recording, what it is planned to
// cost, and the sign-in button, which says the beta is private: you can't
// buy a plan yet, and the first ten people who ask get Pro free (the terms
// point here for that). Two ruled columns in the page's own grammar, no
// cards: on the left what it adds, one line each under an icon, on the
// right the plans as rows, each with its planned price in the machine's
// amber numerals and the word planned beside it, so a reader who never
// reaches the note still reads the price as a plan. Every limit, and Max,
// are in the docs, which the note links. The one picture is live: the badge
// of the recorder's own repository, so it is a receipt and not an
// illustration.
//
// The icons are drawn like the steps' under Set up: the 16-unit grid, a
// square-ended 1.5 stroke in currentColor, one per feature, saying what it
// is (a link, a player, two screens, a pull request, a badge).
import { LinkButton } from '@astrojs/starlight/components';

// Drawn by version.cam's own API, so no visitor's request leaves the site
// for a third party; a README may still let shields.io draw the same JSON.
const BADGE = 'https://api.version.cam/v1/badge/versioncam/versioncam/svg';

const ICONS = {
	// Two links of a chain.
	link: 'M6.5 9.5l3-3M8.5 4.5l1-1a2.83 2.83 0 0 1 4 4l-1 1M7.5 11.5l-1 1a2.83 2.83 0 0 1-4-4l1-1',
	// A player: a frame with a play triangle in it.
	embed: 'M1.5 2.5h13v11h-13zM6.5 5.5v5l4-2.5z',
	// A desktop screen on its stand, and a phone beside it.
	devices: 'M1.5 3.5h9v6.5h-9zM6 10v3M4 13h4M12 6.5h2.5v7H12z',
	// A pull request: a branch that comes back to the line it left.
	pull: 'M4.5 2v12M11.5 14V6.5a2 2 0 0 0-2-2h-2M9 2.5l-2 2 2 2',
	// A badge in two halves, as a README shows one.
	badge: 'M1.5 5.5h13v5h-13zM7.5 5.5v5',
};

const features = [
	{
		icon: ICONS.link,
		name: 'A link that only plays what passed',
		text: 'It plays the newest version from your default branch that passed, and the last good one while a clip is broken.',
	},
	{
		icon: ICONS.embed,
		name: 'Embeds and GIFs',
		text: 'In Notion, Confluence, GitBook and docs sites, and in a README as a GIF.',
	},
	{
		icon: ICONS.devices,
		name: 'A phone and a desktop',
		text: 'Name a phone clip <code>&lt;clip&gt;-mobile</code>, and one link plays the one that fits the screen.',
	},
	{
		icon: ICONS.pull,
		name: 'Clips on the pull request',
		text: 'A check, and one comment with a picture of each clip that changed or failed.',
	},
	{
		icon: ICONS.badge,
		name: 'A README badge',
		text: 'It names the commit CI last checked. This one is live:',
		badge: true,
	},
];
---

<div class="vc-hosted not-content">
	<section class="vc-hosted-col">
		<h3>What it adds</h3>
		<dl class="vc-hosted-what">
			{
				features.map((f) => (
					<div>
						<svg viewBox="0 0 16 16" aria-hidden="true">
							<path d={f.icon} />
						</svg>
						<dt>{f.name}</dt>
						<dd>
							<span set:html={f.text} />
							{f.badge && (
								<a class="vc-badge" href="https://clips.version.cam/versioncam/versioncam">
									<img
										src={BADGE}
										alt="demo verified, the commit and how long ago, for the recorder's own repository"
										height="20"
									/>
								</a>
							)}
						</dd>
					</div>
				))
			}
		</dl>
	</section>

	<section class="vc-hosted-col is-plans">
		<h3>Planned prices</h3>
		<dl class="vc-plans">
			<div>
				<dt>Free <span class="vc-num">$0</span></dt>
				<dd>
					Public repositories: three projects, ten clips each, thirty days of history. The pull request
					check and the README badge.
				</dd>
			</div>
			<div>
				<dt>Pro <span class="vc-num">$35</span> per private project, per month <span class="vc-planned">planned</span></dt>
				<dd>
					Private repositories, whose clips play only for people who can read them on GitHub. Alerts by
					email, Slack or a GitHub issue when a clip breaks. Unlimited history. $350 a year.
				</dd>
			</div>
		</dl>
		<p class="vc-plans-note">
			Per project, not per seat. The prices are planned until the first invoices, and accounts from the
			beta pay 20% less for their first year. Every limit, and Max for ten projects, are in{' '}
			<a href="/more/version-cam/#plans">the docs</a>.
		</p>
		<div class="vc-door">
			<LinkButton href="https://app.version.cam/" icon="right-arrow">Sign in with GitHub</LinkButton>
			<p id="private-beta">
				<strong>Private beta.</strong> There is nothing to buy yet, and we don't ask for a card. The first
				ten people who ask get Pro free for a year: sign in, then email{' '}
				<a href="mailto:hello@version.cam">hello@version.cam</a> with your account name.
			</p>
		</div>
	</section>
</div>
